# API Proxy Configuration
PROXY_URL=http://localhost:8000
PROXY_API_KEY=your-api-key-here

# Local LLM Configuration (MLX-based server)
LLM_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL=qwen/qwen3-14b

# Calendar Agent Server
CALENDAR_AGENT_PORT=8082

# Authentication (see README "Authentication"). Every route but /health needs
# `Authorization: Bearer <token>` (behind uvicorn --root-path, /health does
# too). One name:token pair per caller, separated by commas. Mint a token
# with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is refused at start-up (it is too short), on purpose:
# replace it before starting the server.
CALENDAR_AGENT_API_KEYS=laptop:replace-with-a-generated-token
# required (the default) | optional | off
# CALENDAR_AGENT_AUTH=required

# Mutation timeouts (see README "Coupling with api-proxy"). Leave unset to
# use the defaults; PROXY_CONFIRMATION_WINDOW must mirror the proxy's
# --confirmation-timeout by hand.
# PROXY_CONFIRMATION_WINDOW=300
# PROXY_CONFIRM_TIMEOUT=330
